<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>StarCrew.Launcher</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\Assets\icon.ico</ApplicationIcon>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>
        <DefaultLanguage>zh-CN</DefaultLanguage>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
        <BuildingInsideVisualStudio Condition="'$(BuildingInsideVisualStudio)' == ''"
            >true</BuildingInsideVisualStudio>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="StarCrew.Launcher.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StarCrew.Launcher.Core\StarCrew.Launcher.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.WinUI.Behaviors" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Assets\icon.ico">
            <Link>Assets\icon.ico</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Assets\icon.svg">
            <Link>Assets\icon.svg</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Assets\background.png">
            <Link>Assets\background.png</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Assets\AmongUs.png">
            <Link>Assets\AmongUs.png</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <PropertyGroup>
        <DepotDownloaderVersion>3.4.0</DepotDownloaderVersion>
        <DepotDownloaderDownloadBaseUrl Condition="'$(DepotDownloaderDownloadBaseUrl)' == ''"
            >https://github.com/SteamRE/DepotDownloader/releases/download</DepotDownloaderDownloadBaseUrl>
        <DepotDownloaderAssetName Condition="'$(RuntimeIdentifier)' == 'win-arm64'"
            >DepotDownloader-windows-arm64.zip</DepotDownloaderAssetName>
        <DepotDownloaderAssetName Condition="'$(DepotDownloaderAssetName)' == ''"
            >DepotDownloader-windows-x64.zip</DepotDownloaderAssetName>
        <DepotDownloaderAssetSha256 Condition="'$(RuntimeIdentifier)' == 'win-arm64'"
            >1449BA47775E9974036E615BEDF00D72BEF747CC5B93A78048ED4E0B2C63B2B3</DepotDownloaderAssetSha256>
        <DepotDownloaderAssetSha256 Condition="'$(DepotDownloaderAssetSha256)' == ''"
            >41C9E9F0DF54B3AD02E67A11726756E5C73283BD7C2E1B04ACFA5AE4C2ED3767</DepotDownloaderAssetSha256>
    </PropertyGroup>

    <Target
        Name="FetchDepotDownloader"
        BeforeTargets="AssignTargetPaths"
        Condition="'$(DesignTimeBuild)' != 'true'"
    >
        <PropertyGroup>
            <_DepotDownloaderDir>$([MSBuild]::NormalizeDirectory('$(BaseIntermediateOutputPath)', 'depotdownloader'))</_DepotDownloaderDir>
            <_DepotDownloaderZip>$(_DepotDownloaderDir)$(DepotDownloaderAssetName)</_DepotDownloaderZip>
            <_DepotDownloaderExtractDir>$([MSBuild]::NormalizeDirectory('$(_DepotDownloaderDir)', 'extracted', '$(DepotDownloaderVersion)', '$(DepotDownloaderAssetName)'))</_DepotDownloaderExtractDir>
        </PropertyGroup>
        <DownloadFile
            Condition="!Exists('$(_DepotDownloaderZip)')"
            SourceUrl="$(DepotDownloaderDownloadBaseUrl)/DepotDownloader_$(DepotDownloaderVersion)/$(DepotDownloaderAssetName)"
            DestinationFolder="$(_DepotDownloaderDir)"
        />
        <GetFileHash
            Condition="!Exists('$(_DepotDownloaderExtractDir)DepotDownloader.exe')"
            Files="$(_DepotDownloaderZip)"
            Algorithm="SHA256"
            HashEncoding="hex"
        >
            <Output TaskParameter="Items" ItemName="_DepotDownloaderHashes" />
        </GetFileHash>
        <PropertyGroup>
            <_DepotDownloaderZipHash>@(_DepotDownloaderHashes->'%(FileHash)')</_DepotDownloaderZipHash>
        </PropertyGroup>
        <Error
            Condition="'$(_DepotDownloaderZipHash)' != '' and '$(_DepotDownloaderZipHash)' != '$(DepotDownloaderAssetSha256)'"
            Text="DepotDownloader 校验失败：期望 $(DepotDownloaderAssetSha256)，实际 $(_DepotDownloaderZipHash)。删除 $(_DepotDownloaderZip) 后重试。"
        />
        <Unzip
            Condition="!Exists('$(_DepotDownloaderExtractDir)DepotDownloader.exe')"
            SourceFiles="$(_DepotDownloaderZip)"
            DestinationFolder="$(_DepotDownloaderExtractDir)"
        />
        <ItemGroup>
            <Content
                Include="$(_DepotDownloaderExtractDir)DepotDownloader.exe"
                Link="Tools\DepotDownloader\DepotDownloader.exe"
                CopyToOutputDirectory="PreserveNewest"
            />
            <Content
                Include="$(_DepotDownloaderExtractDir)LICENSE"
                Condition="Exists('$(_DepotDownloaderExtractDir)LICENSE')"
                Link="Tools\DepotDownloader\LICENSE"
                CopyToOutputDirectory="PreserveNewest"
            />
        </ItemGroup>
    </Target>
</Project>
