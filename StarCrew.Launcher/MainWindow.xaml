<Window
    x:Class="StarCrew.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid>
        <Image Source="ms-appx:///Assets/background.webp" Stretch="UniformToFill" />

        <NavigationView
            x:Name="NavView"
            Background="Transparent"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="200"
            PaneDisplayMode="LeftCompact"
        >
            <NavigationView.Resources>
                <StaticResource
                    x:Key="NavigationViewExpandedPaneBackground"
                    ResourceKey="AcrylicInAppFillColorDefaultBrush"
                />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                <StaticResource
                    x:Key="NavigationViewContentBackground"
                    ResourceKey="SolidBackgroundFillColorTransparent"
                />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="启动" Icon="Play" IsSelected="True" />
            </NavigationView.MenuItems>

            <Grid>
                <StackPanel
                    x:Name="ToastPanel"
                    Width="360"
                    Margin="0,60,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="8"
                />
                <Button
                    x:Name="LaunchButton"
                    Width="240"
                    Height="48"
                    Margin="0,0,32,32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="LaunchButton_Click"
                    Content="启动游戏"
                    FontSize="18"
                    Style="{StaticResource AccentButtonStyle}"
                />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
