<Window
    x:Class="StarCrew.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶层标题栏，48 高锁定 Tall 高度；汉堡按钮由 TitleBar 接管，品牌区用 LeftHeader 恢复 24px 图标 + BodyStrong 标题。 -->
        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            Background="Transparent"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
        >
            <TitleBar.LeftHeader>
                <StackPanel
                    Margin="12,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                >
                    <Image Width="24" Height="24">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/icon.svg" />
                        </Image.Source>
                    </Image>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="StarCrew Launcher"
                    />
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="200"
            PaneDisplayMode="LeftCompact"
        >
            <NavigationView.Resources>
                <!-- WinUI 3 的侧边栏背景走 NavigationViewExpandedPaneBackground（折叠/展开态同一个 key，
                     文档里 LeftCompact 对应的 NavigationViewDefaultPaneBackground 模板并未引用）。
                     默认是不透明 LayerFill，会和 Mica 标题栏割裂，故改成透明：侧边栏与标题栏共用同一层 Mica。 -->
                <StaticResource
                    x:Key="NavigationViewExpandedPaneBackground"
                    ResourceKey="SolidBackgroundFillColorTransparent"
                />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                <StaticResource
                    x:Key="NavigationViewContentBackground"
                    ResourceKey="SolidBackgroundFillColorTransparent"
                />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="启动游戏" Icon="Play" IsSelected="True" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid.Resources>
                    <!-- Toast 进场：右侧滑入 + 淡入；退场：右侧滑出 + 淡出。位移与透明度走合成器，不触发布局。 -->
                    <Storyboard x:Name="ToastEnterStoryboard">
                        <DoubleAnimation
                            Storyboard.TargetName="ToastBar"
                            Storyboard.TargetProperty="Opacity"
                            From="0"
                            To="1"
                            Duration="0:0:0.25"
                        >
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="ToastTranslate"
                            Storyboard.TargetProperty="X"
                            From="32"
                            To="0"
                            Duration="0:0:0.25"
                        >
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard
                        x:Name="ToastExitStoryboard"
                        Completed="ToastExitStoryboard_Completed"
                    >
                        <DoubleAnimation
                            Storyboard.TargetName="ToastBar"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.18"
                        >
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="ToastTranslate"
                            Storyboard.TargetProperty="X"
                            To="32"
                            Duration="0:0:0.18"
                        >
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>
                <Image Source="ms-appx:///Assets/background.webp" Stretch="UniformToFill" />
                <!-- 应用内通知走 Toolkit 的 StackedNotificationsBehavior：排队逐条展示、Duration 到期自动关闭、悬停暂停计时。
                     进退场动画由 IsOpen 回调与 Closing 驱动（Closing 里取消关闭、播完退场再真正关闭，不断排队逻辑）。 -->
                <InfoBar
                    x:Name="ToastBar"
                    Width="360"
                    Margin="0,12,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Closing="ToastBar_Closing"
                    IsClosable="True"
                    IsOpen="False"
                >
                    <InfoBar.RenderTransform>
                        <TranslateTransform x:Name="ToastTranslate" />
                    </InfoBar.RenderTransform>
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StackedNotificationsBehavior x:Name="ToastQueue" />
                    </interactivity:Interaction.Behaviors>
                </InfoBar>
                <Button
                    x:Name="LaunchButton"
                    Width="240"
                    Height="48"
                    Margin="0,0,32,32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="LaunchButton_Click"
                    Content="启动游戏"
                    FontSize="18"
                    Style="{StaticResource AccentButtonStyle}"
                />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
