<Window
    x:Class="StarCrew.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="64"
            Background="Transparent">
            <StackPanel
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    Width="32"
                    Height="32"
                    Source="ms-appx:///Assets/icon.png"/>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="StarCrew Launcher"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel
                x:Name="ToastPanel"
                Width="360"
                Margin="0,16,16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Spacing="8"/>
            <Button
                x:Name="LaunchButton"
                Width="240"
                Height="48"
                Margin="0,0,32,32"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="LaunchButton_Click"
                Content="启动游戏"
                FontSize="18"
                Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
