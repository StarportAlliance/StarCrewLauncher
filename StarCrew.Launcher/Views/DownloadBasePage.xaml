<Page
    x:Class="StarCrew.Launcher.Views.DownloadBasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Page.Resources>
        <!-- InfoBadge 的 Value 只接受 Int32，文本标签改走 FrameworkElement.Tag 承载
             默认模板只渲染 Value，这里换成 ContentPresenter -->
        <Style x:Key="TagInfoBadgeStyle" TargetType="InfoBadge">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter
                Property="Foreground"
                Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
            />
            <Setter Property="FontSize" Value="{ThemeResource InfoBadgeValueFontSize}" />
            <Setter Property="Padding" Value="8,1,8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="InfoBadge">
                        <Grid
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                        >
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Tag}"
                                Foreground="{TemplateBinding Foreground}"
                                TextWrapping="NoWrap"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
                <Grid Margin="0,0,0,8">
                    <TextBlock
                        x:Uid="DownloadBase_SectionTitle"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        VerticalAlignment="Center"
                    />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                    >
                        <TextBox
                            x:Uid="DownloadBase_SearchBox"
                            Width="260"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                        <Button
                            x:Uid="DownloadBase_RefreshButton"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                        />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="VersionListStack" Spacing="4" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
