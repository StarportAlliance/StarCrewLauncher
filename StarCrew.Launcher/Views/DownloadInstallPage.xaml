<Page
    x:Class="StarCrew.Launcher.Views.DownloadInstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Padding="24,0,24,24">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
                    <InfoBar
                        x:Uid="Install_NotLoggedInBar"
                        IsOpen="{x:Bind ViewModel.NeedsLogin, Mode=OneWay}"
                        Severity="Warning"
                    />

                    <controls:SettingsCard x:Uid="Install_InstanceNameCard">
                        <TextBox
                            x:Uid="Install_InstanceNameBox"
                            Width="360"
                            HorizontalAlignment="Left"
                            Text="{x:Bind ViewModel.InstanceName, Mode=TwoWay}"
                        />
                    </controls:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" Padding="24,8,24,16">
            <Button
                x:Uid="Install_StartButton"
                HorizontalAlignment="Right"
                Click="InstallButton_Click"
                IsEnabled="{x:Bind ViewModel.CanStartInstall, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
            />
        </Grid>
    </Grid>
</Page>
