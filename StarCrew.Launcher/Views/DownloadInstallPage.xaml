<Page
    x:Class="StarCrew.Launcher.Views.DownloadInstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Esc 与点击空白处都经这里失焦（焦点交给可接焦点的滚动区），与版本列表页同一做法。 -->
        <ScrollViewer
            x:Name="ContentScroll"
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto"
            IsTabStop="True"
            KeyDown="ContentScroll_KeyDown"
        >
            <Grid Padding="24,0,24,24">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.NeedsLogin, Mode=OneWay}"
                        Message="下载原版 Among Us 需要账号凭据。返回后在「游戏下载」→「账号」页扫码登录。"
                        Severity="Warning"
                        Title="尚未登录 Steam 账号"
                    />

                    <controls:SettingsCard
                        Description="下载完成后可在「实例管理」中启动。"
                        Header="实例名称"
                    >
                        <TextBox
                            Width="360"
                            HorizontalAlignment="Left"
                            PlaceholderText="实例名称"
                            Text="{x:Bind ViewModel.InstanceName, Mode=TwoWay}"
                        />
                    </controls:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 主操作沉底：右下角放安装主按钮。 -->
        <Grid Grid.Row="1" Padding="24,8,24,16">
            <Button
                HorizontalAlignment="Right"
                Click="InstallButton_Click"
                Content="开始安装"
                IsEnabled="{x:Bind ViewModel.CanStartInstall, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
            />
        </Grid>
    </Grid>
</Page>
