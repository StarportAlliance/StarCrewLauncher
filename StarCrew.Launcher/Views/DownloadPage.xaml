<Page
    x:Class="StarCrew.Launcher.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 分组用内层 NavigationView：和外层侧栏同一控件，选中竖条动画天然一致。 -->
        <NavigationView
            x:Name="SectionNav"
            Grid.Column="0"
            Margin="12,0,0,24"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectionChanged="SectionNav_SelectionChanged"
        >
            <NavigationView.Resources>
                <!-- 和外层侧栏一致：pane 透明共用 Mica，去边框。 -->
                <StaticResource
                    x:Key="NavigationViewExpandedPaneBackground"
                    ResourceKey="SolidBackgroundFillColorTransparent"
                />
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="DownloadSection_Base" Tag="Base" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="DownloadSection_Account" Tag="Account">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
        </NavigationView>

        <!-- 内容区走 Frame：与设置页一致地用 Windows 原生页面切换动画。 -->
        <Frame x:Name="SectionFrame" Grid.Column="1" IsNavigationStackEnabled="False">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </Grid>
</Page>
