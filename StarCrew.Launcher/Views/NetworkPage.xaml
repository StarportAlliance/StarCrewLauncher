<Page
    x:Class="StarCrew.Launcher.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <StackPanel
                MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}"
            >
                <TextBlock
                    x:Uid="Network_SectionTitle"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />

                <controls:SettingsCard x:Uid="Network_AcceleratorCard">
                    <ComboBox
                        x:Name="AcceleratorCombo"
                        Width="240"
                        ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                    />
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="CustomPrefixCard" x:Uid="Network_CustomPrefixCard">
                    <TextBox
                        x:Uid="Network_CustomPrefixBox"
                        Width="240"
                        Text="{x:Bind ViewModel.CustomPrefix, Mode=TwoWay}"
                    />
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
