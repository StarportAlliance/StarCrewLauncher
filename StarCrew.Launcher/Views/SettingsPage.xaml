<UserControl
    x:Class="StarCrew.Launcher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
    <UserControl.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock"
        >
            <Style.Setters>
                <Setter Property="Margin" Value="1,0,0,6" />
            </Style.Setters>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Resources>
            <!-- 右侧面板切换：淡入 + 小位移，位移与透明度走合成器，不触发布局。 -->
            <Storyboard x:Name="PanelSwitchStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="ContentPanel"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.18"
                >
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="ContentTranslate"
                    Storyboard.TargetProperty="Y"
                    From="16"
                    To="0"
                    Duration="0:0:0.18"
                >
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,16,24,12" Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="SectionList"
                Grid.Column="0"
                Margin="12,0,0,24"
                SelectedIndex="0"
                SelectionChanged="SectionList_SelectionChanged"
                SelectionMode="Single"
            >
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE790;" />
                        <TextBlock VerticalAlignment="Center" Text="外观" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                        <TextBlock VerticalAlignment="Center" Text="关于" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <ScrollViewer
                x:Name="SettingsScroll"
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto"
            >
                <Grid x:Name="ContentPanel" Padding="24,0,24,24">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ContentTranslate" />
                    </Grid.RenderTransform>
                    <StackPanel
                        x:Name="AppearancePanel"
                        MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}"
                    >
                        <StackPanel.ChildrenTransitions>
                            <EntranceThemeTransition FromVerticalOffset="50" />
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </StackPanel.ChildrenTransitions>
                        <TextBlock
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                            Text="外观"
                        />
                        <controls:SettingsCard
                            Header="主题"
                            Description="选择启动器要显示哪种颜色的主题"
                        >
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE790;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox
                                x:Name="ThemeCombo"
                                Width="200"
                                SelectionChanged="ThemeCombo_SelectionChanged"
                            >
                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                            </ComboBox>
                        </controls:SettingsCard>
                    </StackPanel>

                    <StackPanel
                        x:Name="AboutPanel"
                        MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Visibility="Collapsed"
                    >
                        <StackPanel.ChildrenTransitions>
                            <EntranceThemeTransition FromVerticalOffset="50" />
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </StackPanel.ChildrenTransitions>
                        <TextBlock
                            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                            Text="关于"
                        />
                        <controls:SettingsCard x:Name="AboutVersionCard" Header="StarCrewLauncher">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon>
                                    <ImageIcon.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/icon.svg" />
                                    </ImageIcon.Source>
                                </ImageIcon>
                            </controls:SettingsCard.HeaderIcon>
                            <Button
                                x:Name="CheckUpdateButton"
                                Click="CheckUpdateButton_Click"
                                Content="检查更新"
                                Style="{StaticResource AccentButtonStyle}"
                            />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="官方网站"
                            Description="查看教学文档、疑难解答，或是下载最新版本的 SCL 安装程序"
                            IsClickEnabled="True"
                            ActionIconToolTip="在浏览器中打开"
                            Click="WebsiteCard_Click"
                        >
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="问题反馈"
                            Description="使用过程发现了 Bug？想要新的实用功能？欢迎在 GitHub Issues 反馈"
                            IsClickEnabled="True"
                            ActionIconToolTip="在浏览器中打开"
                            Click="FeedbackCard_Click"
                        >
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
