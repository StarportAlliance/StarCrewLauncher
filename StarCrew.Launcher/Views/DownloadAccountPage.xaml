<Page
    x:Class="StarCrew.Launcher.Views.DownloadAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
    <Page.Resources>
        <!-- 退出确认用轻量 Flyout，不需要 Dialog。 -->
        <Flyout x:Name="LogoutFlyout" Placement="Bottom" Closed="LogoutFlyout_Closed">
            <StackPanel Spacing="12">
                <TextBlock x:Uid="Account_LogoutConfirm" />
                <Button
                    x:Uid="Account_LogoutButton"
                    HorizontalAlignment="Right"
                    Click="LogoutConfirm_Click"
                />
            </StackPanel>
        </Flyout>
        <!--  未登录时账号按钮用 accent；基于 AccentButtonStyle 派生以便代码切换。  -->
        <Style
            x:Key="AccountButtonAccentStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button"
        />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
                <TextBlock
                    x:Uid="Account_SectionTitle"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard
                    x:Uid="Account_SteamCard"
                    Description="{x:Bind ViewModel.AccountLabel, Mode=OneWay}"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <!--  Simple Icons 的 Steam 品牌图标（CC0）。 -->
                        <PathIcon Data="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Name="AccountToggle" Click="AccountToggle_Click">
                        <TextBlock x:Name="AccountToggleText" />
                    </Button>
                </controls:SettingsCard>

                <StackPanel Margin="0,8,0,0" Spacing="4">
                    <TextBlock
                        x:Uid="Account_PrivacyNote"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                    />
                </StackPanel>

                <TextBlock
                    x:Uid="Account_ComponentSection"
                    Margin="0,16,0,0"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard x:Uid="Account_DdCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            x:Uid="Account_DownloadSourceSettings"
                            Click="OpenDownloadSourceSettings_Click"
                        />
                        <Button
                            Content="{x:Bind ViewModel.DepotDownloaderInstallButtonText, Mode=OneWay}"
                            Click="InstallDepotDownloader_Click"
                            IsEnabled="{x:Bind ViewModel.CanInstallDepotDownloader, Mode=OneWay}"
                        />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
