<Page
    x:Class="StarCrew.Launcher.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <Grid MaxWidth="1000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Uid="Instances_SectionTitle"
                    Grid.Row="0"
                    Margin="0,16,0,12"
                    Style="{StaticResource TitleTextBlockStyle}"
                />

                <StackPanel
                    Grid.Row="1"
                    x:Name="EmptyPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                >
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            x:Uid="Instances_EmptyHint"
                            VerticalAlignment="Center"
                            Style="{StaticResource TitleTextBlockStyle}"
                        />
                    </StackPanel>
                    <HyperlinkButton
                        x:Uid="Instances_GoDownloadButton"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.GoDownloadCommand}"
                    />
                </StackPanel>

                <StackPanel Grid.Row="1" x:Name="InstancesList" Spacing="4" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
