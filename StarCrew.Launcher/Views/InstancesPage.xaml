<Page
    x:Class="StarCrew.Launcher.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <Grid MaxWidth="1000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Uid="Instances_SectionTitle"
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />

                <!-- 空状态引导：占满剩余空间并整体居中，形如 404 页 -->
                <StackPanel
                    Grid.Row="1"
                    x:Name="EmptyPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                >
                    <TextBlock
                        x:Uid="Instances_EmptyHint"
                        MaxWidth="480"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                    />
                    <Button
                        x:Uid="Instances_GoDownloadButton"
                        Width="200"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.GoDownloadCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                    />
                </StackPanel>

                <!-- 卡片列表：页面代码里按状态生成，不经 DataTemplate -->
                <StackPanel Grid.Row="1" x:Name="InstancesList" Spacing="4" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
