<Page
    x:Class="StarCrew.Launcher.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid>
        <!-- 实例切换与启动按钮叠在背景图右下方，切换时把选中项写回存储 -->
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,32,32"
            Spacing="12"
        >
            <ComboBox
                x:Name="InstanceCombo"
                Width="240"
                Height="40"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}"
            />
            <Button
                x:Name="LaunchButton"
                Width="240"
                Height="48"
                Command="{x:Bind ViewModel.LaunchCommand}"
                Content="{x:Bind ViewModel.LaunchButtonText, Mode=OneWay}"
                FontSize="18"
                Style="{StaticResource AccentButtonStyle}"
            />
        </StackPanel>

        <!-- 左下角显示当前实例名（标题级字号），无实例时为空串即不显示 -->
        <TextBlock
            x:Name="CurrentInstanceNameBlock"
            Style="{StaticResource TitleTextBlockStyle}"
            Margin="32,0,0,32"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Text="{x:Bind ViewModel.CurrentInstanceName, Mode=OneWay}"
        />
    </Grid>
</Page>
