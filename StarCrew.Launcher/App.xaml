<Application
    x:Class="StarCrew.Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!--  品牌 accent 色板：浅色主题主色 #1E96E8 落在 Light2（浅色主题 accent 笔刷的解析槽位），
                  深色主题主色 #7FCCFF 落在 Dark1（深色主题 accent 笔刷的解析槽位），其余槽位为品牌色的明暗梯度。  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#1A83CB</Color>
                    <Color x:Key="SystemAccentColorLight1">#1C8DDA</Color>
                    <Color x:Key="SystemAccentColorLight2">#1E96E8</Color>
                    <Color x:Key="SystemAccentColorLight3">#4BAFEE</Color>
                    <Color x:Key="SystemAccentColorDark1">#1771AE</Color>
                    <Color x:Key="SystemAccentColorDark2">#115380</Color>
                    <Color x:Key="SystemAccentColorDark3">#0B3551</Color>
                    <!-- 自绘亚克力：模糊度固定为 18（系统内置是 30，整体调弱），着色随主题切换。 -->
                    <media:AcrylicBrush
                        x:Key="LauncherAcrylicBrush"
                        BlurAmount="18"
                        FallbackColor="#F9F9F9"
                        TintColor="#FCFCFC"
                        TintOpacity="0.5"
                    />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#8ED1FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#9FD9FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#B9E3FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#D2EDFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#7FCCFF</Color>
                    <Color x:Key="SystemAccentColorDark2">#6CADD9</Color>
                    <Color x:Key="SystemAccentColorDark3">#598FB3</Color>
                    <media:AcrylicBrush
                        x:Key="LauncherAcrylicBrush"
                        BlurAmount="18"
                        FallbackColor="#1C1C1C"
                        TintColor="#202020"
                        TintOpacity="0.5"
                    />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Style
                x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Style.Setters>
                    <Setter Property="Margin" Value="1,0,0,6" />
                </Style.Setters>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
