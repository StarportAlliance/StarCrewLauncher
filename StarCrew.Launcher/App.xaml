<Application
    x:Class="StarCrew.Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#1A83CB</Color>
                    <Color x:Key="SystemAccentColorLight1">#1C8DDA</Color>
                    <Color x:Key="SystemAccentColorLight2">#1E96E8</Color>
                    <Color x:Key="SystemAccentColorLight3">#4BAFEE</Color>
                    <Color x:Key="SystemAccentColorDark1">#1771AE</Color>
                    <Color x:Key="SystemAccentColorDark2">#115380</Color>
                    <Color x:Key="SystemAccentColorDark3">#0B3551</Color>
                    <AcrylicBrush
                        x:Key="LauncherAcrylicBrush"
                        FallbackColor="#F7F7F7"
                        TintColor="#FCFCFC"
                        TintLuminosityOpacity="0.88"
                        TintOpacity="0.55"
                    />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#8ED1FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#9FD9FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#B9E3FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#D2EDFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#7FCCFF</Color>
                    <Color x:Key="SystemAccentColorDark2">#6CADD9</Color>
                    <Color x:Key="SystemAccentColorDark3">#598FB3</Color>
                    <AcrylicBrush
                        x:Key="LauncherAcrylicBrush"
                        FallbackColor="#1C1C1C"
                        TintColor="#202020"
                        TintLuminosityOpacity="0.68"
                        TintOpacity="0.25"
                    />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="AppDisplayFontFamily">XamlAutoFontFamily</FontFamily>
            <!-- 150% 缩放下字形常落在半像素，灰度抗锯齿占比高；字号 +1 可压低灰边比例 -->
            <x:Double x:Key="ControlContentThemeFontSize">15</x:Double>
            <x:Double x:Key="SettingsCardDescriptionFontSize">13</x:Double>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
            </Style>
            <!-- 复刻 WinUI 排版样式，额外替换字体族并整体上调字号；字重需随 WindowsAppSDK 升级复核 -->
            <Style
                x:Key="CaptionTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style
                x:Key="BodyTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style
                x:Key="BodyStrongTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style
                x:Key="BodyLargeTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style
                x:Key="SubtitleTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="21" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style
                x:Key="TitleTextBlockStyle"
                BasedOn="{StaticResource BaseTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Style
                x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock"
            >
                <Style.Setters>
                    <Setter Property="Margin" Value="1,0,0,6" />
                    <Setter Property="FontFamily" Value="{ThemeResource AppDisplayFontFamily}" />
                </Style.Setters>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
