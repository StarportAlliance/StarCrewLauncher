<Page
    x:Class="StarportAlliance.StarCrewLauncher.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:i18n="using:StarportAlliance.StarCrewLauncher.Markup"
>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <StackPanel
                x:Name="AboutPanel"
                MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}"
            >
                <TextBlock
                    Text="{x:Bind i18n:Loc.Get('About_Title')}"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard
                    x:Name="AboutVersionCard"
                    Header="StarCrewLauncher"
                    Description="{x:Bind ViewModel.VersionDescription}"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon x:Name="AppIcon">
                            <ImageIcon.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/icon.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="CheckUpdateButton"
                        Content="{x:Bind i18n:Loc.Get('About_CheckUpdateButton')}"
                        Command="{x:Bind ViewModel.CheckUpdateCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                    />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_WebsiteCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_WebsiteCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="WebsiteCard_Click"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_FeedbackCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_FeedbackCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="FeedbackCard_Click"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEBE8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <TextBlock
                    Text="{x:Bind i18n:Loc.Get('About_LegalSection')}"
                    Margin="1,12,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_LicenseCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_LicenseCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="LicenseCard_Click"
                >
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_NoticeCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_NoticeCardDescription')}"
                ></controls:SettingsCard>
                <TextBlock
                    Text="{x:Bind i18n:Loc.Get('About_LicenseSection')}"
                    Margin="1,12,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_WasdkCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_WasdkCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="WindowsAppSdkLicenseCard_Click"
                >
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_ToolkitCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_ToolkitCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="CommunityToolkitLicenseCard_Click"
                >
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_VelopackCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_VelopackCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="VelopackLicenseCard_Click"
                >
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_SddCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_SddCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="StarDepotDownloaderLicenseCard_Click"
                >
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('About_FluentlauncherCard')}"
                    Description="{x:Bind i18n:Loc.Get('About_FluentlauncherCardDescription')}"
                    ActionIconToolTip="{x:Bind i18n:Loc.Get('Common_OpenInBrowser')}"
                    IsClickEnabled="True"
                    Click="FluentlauncherLicenseCard_Click"
                >
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
