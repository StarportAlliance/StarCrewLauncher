<Page
    x:Class="StarportAlliance.StarCrewLauncher.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:StarportAlliance.StarCrewLauncher.ViewModels"
    xmlns:i18n="using:StarportAlliance.StarCrewLauncher.Markup"
>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <Grid MaxWidth="1000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Text="{x:Bind i18n:Loc.Get('Instances_Title')}"
                    Grid.Row="0"
                    Margin="0,16,0,12"
                    Style="{StaticResource TitleTextBlockStyle}"
                />

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasNoInstances, Mode=OneWay}"
                >
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Text="{x:Bind i18n:Loc.Get('Instances_EmptyHint')}"
                            VerticalAlignment="Center"
                            Style="{StaticResource TitleTextBlockStyle}"
                        />
                    </StackPanel>
                    <HyperlinkButton
                        Content="{x:Bind i18n:Loc.Get('Instances_GoDownloadButton')}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.GoDownloadCommand}"
                    />
                </StackPanel>

                <ItemsRepeater
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasInstances, Mode=OneWay}"
                >
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstanceItemViewModel">
                            <controls:SettingsCard
                                Description="{x:Bind Summary}"
                                Header="{x:Bind Name}"
                            >
                                <controls:SettingsCard.HeaderIcon>
                                    <ImageIcon>
                                        <ImageIcon.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/icon.svg" />
                                        </ImageIcon.Source>
                                    </ImageIcon>
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="{x:Bind i18n:Loc.Get('Instances_CardLaunch')}"
                                        Command="{x:Bind LaunchCommand}"
                                        IsEnabled="{x:Bind CanLaunch}"
                                        Style="{StaticResource AccentButtonStyle}"
                                    />
                                    <Button
                                        Content="{x:Bind i18n:Loc.Get('Instances_CardOpenFolder')}"
                                        Command="{x:Bind OpenFolderCommand}"
                                    />
                                    <DropDownButton Content="{x:Bind i18n:Loc.Get('Instances_CardMore')}">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Text="{x:Bind i18n:Loc.Get('Instances_CardRename')}"
                                                    Command="{x:Bind RequestRenameCommand}"
                                                />
                                                <MenuFlyoutItem
                                                    Text="{x:Bind i18n:Loc.Get('Instances_CardDetails')}"
                                                    Command="{x:Bind RequestDetailsCommand}"
                                                />
                                                <MenuFlyoutItem
                                                    Text="{x:Bind i18n:Loc.Get('Common_Delete')}"
                                                    Command="{x:Bind RequestDeleteCommand}"
                                                />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
