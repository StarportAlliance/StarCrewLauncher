<Page
    x:Class="StarportAlliance.StarCrewLauncher.Views.DownloadInstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:i18n="using:StarportAlliance.StarCrewLauncher.Markup"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <BreadcrumbBar
            x:Name="TitleBreadcrumb"
            Grid.Row="0"
            Margin="14,16,24,8"
            ItemClicked="TitleBreadcrumb_ItemClicked"
        >
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock
                        Margin="10,0"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind}"
                        TextTrimming="CharacterEllipsis"
                    />
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="24,0,24,24">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
                    <InfoBar
                        Title="{x:Bind i18n:Loc.Get('Install_NotLoggedInBar')}"
                        Message="{x:Bind i18n:Loc.Get('Download_LoginHintMessage')}"
                        IsOpen="{x:Bind ViewModel.NeedsLogin, Mode=OneWay}"
                        Severity="Warning"
                    />

                    <controls:SettingsCard
                        Header="{x:Bind i18n:Loc.Get('Install_InstanceName')}"
                        Description="{x:Bind i18n:Loc.Get('Install_InstanceNameCardDescription')}"
                    >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </controls:SettingsCard.HeaderIcon>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6"
                                ToolTipService.ToolTip="{x:Bind ViewModel.InstanceNameError, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasInstanceNameError, Mode=OneWay}"
                            >
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE783;"
                                />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.InstanceNameError, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                />
                            </StackPanel>
                            <TextBox
                                PlaceholderText="{x:Bind i18n:Loc.Get('Install_InstanceName')}"
                                Grid.Column="1"
                                Width="360"
                                Text="{x:Bind ViewModel.InstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            />
                        </Grid>
                    </controls:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="24,8,24,16">
            <Button
                Width="240"
                Height="48"
                HorizontalAlignment="Center"
                Click="InstallButton_Click"
                FontSize="18"
                IsEnabled="{x:Bind ViewModel.CanStartInstall, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
            >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" />
                    <TextBlock Text="{x:Bind i18n:Loc.Get('Install_StartButton')}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
