<Page
    x:Class="StarportAlliance.StarCrewLauncher.Views.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:i18n="using:StarportAlliance.StarCrewLauncher.Markup"
>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <StackPanel
                x:Name="AdvancedPanel"
                MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}"
            >
                <TextBlock
                    Text="{x:Bind i18n:Loc.Get('Logging_SectionTitle')}"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsExpander
                    Header="{x:Bind i18n:Loc.Get('Logging_Expander')}"
                    Description="{x:Bind i18n:Loc.Get('Common_RestartRequiredHint')}"
                >
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch
                        OnContent="{x:Bind i18n:Loc.Get('Logging_EnableToggleOn')}"
                        OffContent="{x:Bind i18n:Loc.Get('Logging_EnableToggleOff')}"
                        IsOn="{x:Bind ViewModel.LoggingEnabled, Mode=TwoWay}"
                    />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind i18n:Loc.Get('Logging_LevelCard')}">
                            <ComboBox
                                Width="120"
                                SelectedIndex="{x:Bind ViewModel.SelectedLevelIndex, Mode=TwoWay}"
                            >
                                <ComboBoxItem Content="{x:Bind i18n:Loc.Get('Logging_LevelVerbose')}" />
                                <ComboBoxItem Content="{x:Bind i18n:Loc.Get('Logging_LevelDebug')}" />
                                <ComboBoxItem Content="{x:Bind i18n:Loc.Get('Logging_LevelInformation')}" />
                                <ComboBoxItem Content="{x:Bind i18n:Loc.Get('Logging_LevelWarning')}" />
                                <ComboBoxItem Content="{x:Bind i18n:Loc.Get('Logging_LevelError')}" />
                                <ComboBoxItem Content="{x:Bind i18n:Loc.Get('Logging_LevelFatal')}" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="{x:Bind i18n:Loc.Get('Logging_RetentionCard')}"
                            Description="{x:Bind i18n:Loc.Get('Logging_RetentionCardDescription')}"
                        >
                            <NumberBox
                                Minimum="1"
                                Maximum="33550336"
                                LostFocus="RetentionBox_LostFocus"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.RetentionDays, Mode=TwoWay}"
                            />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="{x:Bind i18n:Loc.Get('Logging_FolderCard')}"
                            ActionIconToolTip="{x:Bind i18n:Loc.Get('Logging_OpenFolderToolTip')}"
                            IsClickEnabled="True"
                            Click="FolderCard_Click"
                        >
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <TextBlock
                    Text="{x:Bind i18n:Loc.Get('Cache_SectionTitle')}"
                    Margin="1,12,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('Cache_VersionExpiryCard')}"
                    Description="{x:Bind i18n:Loc.Get('Cache_VersionExpiryCardDescription')}"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xECC5;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox
                        Minimum="0"
                        Maximum="720"
                        LostFocus="VersionExpiryBox_LostFocus"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.VersionCacheHours, Mode=TwoWay}"
                    />
                </controls:SettingsCard>
                <TextBlock
                    Text="{x:Bind i18n:Loc.Get('Network_SectionTitle')}"
                    Margin="1,12,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('Network_AuthCacheCard')}"
                    Description="{x:Bind i18n:Loc.Get('Network_AuthCacheCardDescription')}"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xECC5;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox
                        Minimum="0"
                        Maximum="86400"
                        LostFocus="AuthCacheBox_LostFocus"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.AuthCacheSeconds, Mode=TwoWay}"
                    />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="{x:Bind i18n:Loc.Get('Network_Timeout')}"
                    Description="{x:Bind i18n:Loc.Get('Network_TimeoutCardDescription')}"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox
                        Minimum="1"
                        Maximum="30"
                        LostFocus="NetworkTimeoutBox_LostFocus"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.NetworkTimeoutSeconds, Mode=TwoWay}"
                    />
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
