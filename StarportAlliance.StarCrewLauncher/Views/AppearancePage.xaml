<Page
    x:Class="StarportAlliance.StarCrewLauncher.Views.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:StarportAlliance.StarCrewLauncher.Models"
    xmlns:viewModels="using:StarportAlliance.StarCrewLauncher.ViewModels"
    xmlns:views="using:StarportAlliance.StarCrewLauncher.Views"
>
    <Page.Resources>
        <views:HexColorConverter x:Key="HexColorConverter" />
        <views:ScrimOpacityPercentConverter x:Key="ScrimOpacityPercentConverter" />
        <controls:ContrastBrushConverter x:Key="ContrastBrushConverter" />
        <DataTemplate
            x:Key="BuiltInBackgroundCardTemplate"
            x:DataType="viewModels:BuiltInBackgroundOptionViewModel"
        >
            <Grid Height="190" MaxWidth="240">
                <Button
                    Padding="8"
                    AutomationProperties.Name="{x:Bind DisplayName}"
                    Command="{x:Bind SelectCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                >
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton
                                Margin="8,0,0,0"
                                MinWidth="0"
                                Padding="0"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                GroupName="LauncherBackgroundImage"
                                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                            />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                            />
                        </Grid>
                        <Rectangle Height="126" RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <ImageBrush
                                    ImageSource="{x:Bind ImageSource}"
                                    Stretch="UniformToFill"
                                />
                            </Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>
                </Button>
                <Border
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay}"
                />
                <Border
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsHighlighted, Mode=OneWay}"
                />
            </Grid>
        </DataTemplate>
        <DataTemplate
            x:Key="CustomBackgroundCardTemplate"
            x:DataType="views:CustomBackgroundImageCardViewModel"
        >
            <Grid Height="190" MaxWidth="240">
                <Grid Visibility="{x:Bind HasCustomBackgroundImage, Mode=OneWay}">
                    <Button
                        Padding="8"
                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                        Command="{x:Bind SelectCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                    >
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    Margin="8,0,0,0"
                                    MinWidth="0"
                                    Padding="0"
                                    GroupName="LauncherBackgroundImage"
                                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,44,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextAlignment="Left"
                                    TextTrimming="CharacterEllipsis"
                                />
                            </Grid>
                            <Rectangle Height="126" RadiusX="4" RadiusY="4">
                                <Rectangle.Fill>
                                    <ImageBrush
                                        ImageSource="{x:Bind Thumbnail, Mode=OneWay}"
                                        Stretch="UniformToFill"
                                    />
                                </Rectangle.Fill>
                            </Rectangle>
                        </StackPanel>
                    </Button>
                    <Border
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}"
                    />
                    <Border
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind IsHighlighted, Mode=OneWay}"
                    />
                    <Button
                        x:Uid="Appearance_BackgroundImageRemove"
                        Width="32"
                        Height="32"
                        Margin="0,8,8,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{x:Bind RemoveCommand}"
                    >
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                </Grid>
                <Button
                    x:Uid="Appearance_BackgroundImageAdd"
                    Height="190"
                    MaxWidth="240"
                    Padding="8"
                    Command="{x:Bind AddCommand}"
                    VerticalContentAlignment="Center"
                    Visibility="{x:Bind CanAddBackgroundImage, Mode=OneWay}"
                >
                    <StackPanel Width="204" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon FontSize="24" Glyph="&#xE710;" />
                        <TextBlock
                            x:Uid="Appearance_BackgroundImageAddText"
                            HorizontalAlignment="Center"
                        />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
        <views:BackgroundImageCardTemplateSelector
            x:Key="BackgroundImageCardTemplateSelector"
            BuiltInTemplate="{StaticResource BuiltInBackgroundCardTemplate}"
            CustomTemplate="{StaticResource CustomBackgroundCardTemplate}"
        />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24">
            <StackPanel
                x:Name="AppearancePanel"
                MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}"
            >
                <TextBlock
                    x:Uid="Appearance_SectionTitle"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                />
                <controls:SettingsCard x:Uid="Appearance_ThemeCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE793;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ThemeCombo"
                        Width="120"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                    >
                        <ComboBoxItem x:Uid="Appearance_ThemeSystem" Tag="System" />
                        <ComboBoxItem x:Uid="Appearance_ThemeLight" Tag="Light" />
                        <ComboBoxItem x:Uid="Appearance_ThemeDark" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsExpander x:Uid="Appearance_AccentExpander" IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE771;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.ItemsHeader>
                        <InfoBar
                            x:Name="AccentHighContrastBar"
                            x:Uid="Appearance_AccentHighContrastBar"
                            Margin="58,8,44,8"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning"
                            Visibility="Collapsed"
                        />
                    </controls:SettingsExpander.ItemsHeader>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            x:Uid="Appearance_AccentLightCard"
                            x:Name="AccentLightCard"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ColorPickerButton
                                    x:Name="LightAccentPicker"
                                    x:Uid="Appearance_AccentLightPicker"
                                    MinWidth="128"
                                    HorizontalContentAlignment="Center"
                                    SelectedColor="{x:Bind ViewModel.LightAccentColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}"
                                >
                                    <TextBlock
                                        Margin="6,0"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.LightAccentColor, Mode=OneWay}"
                                        Foreground="{x:Bind LightAccentPicker.SelectedColor, Mode=OneWay, Converter={StaticResource ContrastBrushConverter}}"
                                    />
                                </controls:ColorPickerButton>
                                <Button
                                    x:Uid="Appearance_AccentLightReset"
                                    Command="{x:Bind ViewModel.ResetLightAccentCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanResetLightAccent, Mode=OneWay}"
                                />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Uid="Appearance_AccentDarkCard"
                            x:Name="AccentDarkCard"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ColorPickerButton
                                    x:Name="DarkAccentPicker"
                                    x:Uid="Appearance_AccentDarkPicker"
                                    MinWidth="128"
                                    HorizontalContentAlignment="Center"
                                    SelectedColor="{x:Bind ViewModel.DarkAccentColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}"
                                >
                                    <TextBlock
                                        Margin="6,0"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.DarkAccentColor, Mode=OneWay}"
                                        Foreground="{x:Bind DarkAccentPicker.SelectedColor, Mode=OneWay, Converter={StaticResource ContrastBrushConverter}}"
                                    />
                                </controls:ColorPickerButton>
                                <Button
                                    x:Uid="Appearance_AccentDarkReset"
                                    Command="{x:Bind ViewModel.ResetDarkAccentCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanResetDarkAccent, Mode=OneWay}"
                                />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsCard x:Uid="Appearance_FontCard">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Font" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Name="FontCombo"
                            x:Uid="Appearance_FontCombo"
                            MinWidth="300"
                            MaxDropDownHeight="400"
                            ItemsSource="{x:Bind ViewModel.FontOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedFontOption, Mode=TwoWay}"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FontOption">
                                    <Grid ColumnSpacing="16" MinWidth="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            MaxWidth="160"
                                            Text="{x:Bind OriginalName}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            x:Uid="Appearance_FontReset"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ResetFontCommand}"
                            IsEnabled="{x:Bind ViewModel.CanResetFont, Mode=OneWay}"
                        />
                    </StackPanel>
                </controls:SettingsCard>

                <StackPanel Margin="1,12,0,6" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Uid="Appearance_BackgroundSectionTitle"
                        Margin="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    />
                    <TextBlock
                        x:Uid="Appearance_BackgroundRestartHint"
                        Margin="0"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                    />
                </StackPanel>
                <InfoBar
                    x:Uid="Appearance_MicaUnsupportedBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsMicaUnsupported, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.IsMicaUnsupported, Mode=OneWay}"
                />
                <controls:SettingsCard IsEnabled="{x:Bind ViewModel.IsMicaSupported, Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <RadioButton
                            x:Uid="Appearance_MicaRadio"
                            Padding="20,0,0,0"
                            GroupName="LauncherBackground"
                            IsChecked="{x:Bind ViewModel.IsMicaBackground, Mode=TwoWay}"
                            VerticalContentAlignment="Center"
                        >
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Uid="Appearance_MicaOptionTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                />
                                <TextBlock
                                    x:Uid="Appearance_MicaOptionDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                />
                            </StackPanel>
                        </RadioButton>
                    </controls:SettingsCard.Header>
                </controls:SettingsCard>
                <controls:SettingsExpander>
                    <controls:SettingsExpander.Header>
                        <RadioButton
                            x:Uid="Appearance_SolidRadio"
                            Padding="20,0,0,0"
                            GroupName="LauncherBackground"
                            IsChecked="{x:Bind ViewModel.IsSolidBackground, Mode=TwoWay}"
                            VerticalContentAlignment="Center"
                        >
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Uid="Appearance_SolidOptionTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                />
                                <TextBlock
                                    x:Uid="Appearance_SolidOptionDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                />
                            </StackPanel>
                        </RadioButton>
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            x:Uid="Appearance_SolidColorItem"
                            IsEnabled="{x:Bind ViewModel.IsSolidBackground, Mode=OneWay}"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:ColorPickerButton
                                    x:Name="SolidColorPicker"
                                    x:Uid="Appearance_SolidColorPicker"
                                    MinWidth="128"
                                    HorizontalContentAlignment="Center"
                                    SelectedColor="{x:Bind ViewModel.SolidBackgroundColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}"
                                >
                                    <Grid MinWidth="110" Height="22">
                                        <Border
                                            Background="{ThemeResource LauncherSolidBackgroundBrush}"
                                            CornerRadius="2"
                                            Visibility="{x:Bind ViewModel.IsSolidBackgroundColorFollowTheme, Mode=OneWay}"
                                        />
                                        <Grid Visibility="{x:Bind ViewModel.IsSolidBackground, Mode=OneWay}">
                                            <TextBlock
                                                Margin="6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SolidBackgroundColorLabel, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.IsSolidBackgroundColorFollowTheme, Mode=OneWay}"
                                            />
                                            <TextBlock
                                                Margin="6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Bind SolidColorPicker.SelectedColor, Mode=OneWay, Converter={StaticResource ContrastBrushConverter}}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SolidBackgroundColorLabel, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.CanResetSolidBackgroundColor, Mode=OneWay}"
                                            />
                                        </Grid>
                                        <TextBlock
                                            Margin="6,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.SolidBackgroundColorLabel, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsSolidBackgroundColorLabelDisabled, Mode=OneWay}"
                                        />
                                    </Grid>
                                </controls:ColorPickerButton>
                                <Button
                                    x:Uid="Appearance_SolidColorReset"
                                    Command="{x:Bind ViewModel.ResetSolidBackgroundColorCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanResetSolidBackgroundColor, Mode=OneWay}"
                                />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsExpander>
                    <controls:SettingsExpander.Header>
                        <RadioButton
                            x:Uid="Appearance_ImageRadio"
                            Padding="20,0,0,0"
                            GroupName="LauncherBackground"
                            IsChecked="{x:Bind ViewModel.IsImageBackground, Mode=TwoWay}"
                            VerticalContentAlignment="Center"
                        >
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Uid="Appearance_ImageOptionTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                />
                                <TextBlock
                                    x:Uid="Appearance_ImageOptionDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                />
                            </StackPanel>
                        </RadioButton>
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            ContentAlignment="Left"
                            HorizontalContentAlignment="Left"
                            IsEnabled="{x:Bind ViewModel.IsImageBackground, Mode=OneWay}"
                        >
                            <ItemsRepeater
                                ItemsSource="{x:Bind BackgroundImageCards}"
                                ItemTemplate="{StaticResource BackgroundImageCardTemplateSelector}"
                            >
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="12"
                                        MinItemWidth="200"
                                        MinRowSpacing="12"
                                    />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Uid="Appearance_ScrimCard"
                            IsEnabled="{x:Bind ViewModel.IsImageBackground, Mode=OneWay}"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider
                                    x:Uid="Appearance_ScrimSlider"
                                    MinWidth="180"
                                    Maximum="1"
                                    Minimum="0"
                                    StepFrequency="0.01"
                                    ThumbToolTipValueConverter="{StaticResource ScrimOpacityPercentConverter}"
                                    Value="{x:Bind ViewModel.ScrimOpacity, Mode=TwoWay}"
                                />
                                <TextBlock
                                    MinWidth="40"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.ScrimOpacityLabel, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsImageBackground, Mode=OneWay}"
                                />
                                <TextBlock
                                    MinWidth="40"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                    Text="{x:Bind ViewModel.ScrimOpacityLabel, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsScrimOpacityDisabled, Mode=OneWay}"
                                />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
