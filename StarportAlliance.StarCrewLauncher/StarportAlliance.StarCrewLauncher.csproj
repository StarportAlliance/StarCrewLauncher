<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>StarportAlliance.StarCrewLauncher</RootNamespace>
        <AssemblyName>StarCrewLauncher</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\Assets\icon.ico</ApplicationIcon>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>
        <DefaultLanguage>zh-CN</DefaultLanguage>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
        <BuildingInsideVisualStudio Condition="'$(BuildingInsideVisualStudio)' == ''"
            >true</BuildingInsideVisualStudio>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="CommunityToolkit.WinUI.Behaviors" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.ColorPicker" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Windows.CsWin32">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Assets\icon.ico">
            <Link>Assets\icon.ico</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Assets\icon.svg">
            <Link>Assets\icon.svg</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Assets\BuiltinBackground\*">
            <Link>Assets\BuiltinBackground\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Assets\AmongUs.png">
            <Link>Assets\AmongUs.png</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <PropertyGroup>
        <StarDepotDownloaderVersion>1.0.0</StarDepotDownloaderVersion>
        <StarDepotDownloaderDownloadBaseUrl
            Condition="'$(StarDepotDownloaderDownloadBaseUrl)' == ''"
            >https://github.com/StarportAlliance/StarDepotDownloader/releases/download</StarDepotDownloaderDownloadBaseUrl>
        <StarDepotDownloaderAssetName Condition="'$(RuntimeIdentifier)' == 'win-arm64'"
            >StarDepotDownloader_Win_Arm64.zip</StarDepotDownloaderAssetName>
        <StarDepotDownloaderAssetName Condition="'$(StarDepotDownloaderAssetName)' == ''"
            >StarDepotDownloader_Win_x64.zip</StarDepotDownloaderAssetName>
        <StarDepotDownloaderAssetSha256 Condition="'$(RuntimeIdentifier)' == 'win-arm64'"
            >B93988EB8FE3E4940BE139FE4B3D889DA29173C4A009B5430032913632EDF1E3</StarDepotDownloaderAssetSha256>
        <StarDepotDownloaderAssetSha256 Condition="'$(StarDepotDownloaderAssetSha256)' == ''"
            >AD4C317243425831726BE8AB01917414DEFDD1B5B40F633C036321725D2FCA01</StarDepotDownloaderAssetSha256>
    </PropertyGroup>

    <Target
        Name="FetchStarDepotDownloader"
        BeforeTargets="AssignTargetPaths"
        Condition="'$(DesignTimeBuild)' != 'true'"
    >
        <PropertyGroup>
            <_StarDepotDownloaderDir>$([MSBuild]::NormalizeDirectory('$(BaseIntermediateOutputPath)', 'stardepotdownloader'))</_StarDepotDownloaderDir>
            <_StarDepotDownloaderZip>$(_StarDepotDownloaderDir)$(StarDepotDownloaderAssetName)</_StarDepotDownloaderZip>
            <_StarDepotDownloaderExtractDir>$([MSBuild]::NormalizeDirectory('$(_StarDepotDownloaderDir)', 'extracted', '$(StarDepotDownloaderVersion)', '$(StarDepotDownloaderAssetName)'))</_StarDepotDownloaderExtractDir>
            <_StarDepotDownloaderLocalDir Condition="'$(StarDepotDownloaderLocalDir)' != ''"
                >$([MSBuild]::NormalizeDirectory('$(StarDepotDownloaderLocalDir)'))</_StarDepotDownloaderLocalDir>
            <_StarDepotDownloaderUseLocal Condition="'$(_StarDepotDownloaderLocalDir)' != ''"
                >true</_StarDepotDownloaderUseLocal>
            <_StarDepotDownloaderSourceDir Condition="'$(_StarDepotDownloaderUseLocal)' == 'true'"
                >$(_StarDepotDownloaderLocalDir)</_StarDepotDownloaderSourceDir>
            <_StarDepotDownloaderSourceDir Condition="'$(_StarDepotDownloaderUseLocal)' != 'true'"
                >$(_StarDepotDownloaderExtractDir)</_StarDepotDownloaderSourceDir>
        </PropertyGroup>
        <Error
            Condition="'$(_StarDepotDownloaderUseLocal)' == 'true' and !Exists('$(_StarDepotDownloaderSourceDir)StarDepotDownloader.exe')"
            Text="StarDepotDownloaderLocalDir 未包含 StarDepotDownloader.exe：$(_StarDepotDownloaderSourceDir)"
        />
        <DownloadFile
            Condition="'$(_StarDepotDownloaderUseLocal)' != 'true' and !Exists('$(_StarDepotDownloaderZip)')"
            SourceUrl="$(StarDepotDownloaderDownloadBaseUrl)/$(StarDepotDownloaderVersion)/$(StarDepotDownloaderAssetName)"
            DestinationFolder="$(_StarDepotDownloaderDir)"
        />
        <GetFileHash
            Condition="'$(_StarDepotDownloaderUseLocal)' != 'true' and !Exists('$(_StarDepotDownloaderExtractDir)StarDepotDownloader.exe')"
            Files="$(_StarDepotDownloaderZip)"
            Algorithm="SHA256"
            HashEncoding="hex"
        >
            <Output TaskParameter="Items" ItemName="_StarDepotDownloaderHashes" />
        </GetFileHash>
        <PropertyGroup>
            <_StarDepotDownloaderZipHash>@(_StarDepotDownloaderHashes->'%(FileHash)')</_StarDepotDownloaderZipHash>
        </PropertyGroup>
        <Error
            Condition="'$(_StarDepotDownloaderUseLocal)' != 'true' and '$(_StarDepotDownloaderZipHash)' != '' and '$(_StarDepotDownloaderZipHash)' != '$(StarDepotDownloaderAssetSha256)'"
            Text="StarDepotDownloader 校验失败：期望 $(StarDepotDownloaderAssetSha256)，实际 $(_StarDepotDownloaderZipHash)。删除 $(_StarDepotDownloaderZip) 后重试。"
        />
        <Unzip
            Condition="'$(_StarDepotDownloaderUseLocal)' != 'true' and !Exists('$(_StarDepotDownloaderExtractDir)StarDepotDownloader.exe')"
            SourceFiles="$(_StarDepotDownloaderZip)"
            DestinationFolder="$(_StarDepotDownloaderExtractDir)"
        />
        <ItemGroup>
            <_StarDepotDownloaderFiles
                Include="$(_StarDepotDownloaderSourceDir)**\*"
                Exclude="$(_StarDepotDownloaderSourceDir)**\*.pdb"
            />
        </ItemGroup>
        <ItemGroup>
            <Content
                Include="@(_StarDepotDownloaderFiles)"
                Link="Tools\StarDepotDownloader\%(RecursiveDir)%(Filename)%(Extension)"
                CopyToOutputDirectory="PreserveNewest"
            />
        </ItemGroup>
    </Target>
</Project>
