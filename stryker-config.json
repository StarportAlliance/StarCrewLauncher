{
  // 变异测试（Stryker.NET）：覆盖率只能证明“跑到了”，变异测试证明“断言真有用”。
  // 手动运行：dotnet tool restore，然后 dotnet stryker
  // 建议每夜跑一次，不进 CI/PR 门禁（太慢）。
  // 注意：只变异可单元测试的 Services/Models；XAML 代码隐藏不可单元测试，不变异。
  // mutate 通配符相对 projectRoot（即类库目录）解析，必须写类库相对路径。
  // 2026-10-02 实测（Stryker 5.0.0）：79 个参测变异，杀死 52、存活 27，变异分 61.90%；
  // 存活最多的是 String mutation×10，集中在 WindowsSteamEnvironment 的注册表键名/
  // 路径字面量（真机 OS 相关，单元测不到）；GameLauncher 决策逻辑变异存活为 0。
  "stryker-config": {
    "solution": "StarCrew.Launcher.slnx",
    "project": "StarCrew.Launcher.Core.csproj",
    "test-projects": ["StarCrew.Launcher.Tests/StarCrew.Launcher.Tests.csproj"],
    "mutate": ["Services/**/*.cs", "Models/**/*.cs"],
    "reporters": ["html", "progress"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    }
  }
}
