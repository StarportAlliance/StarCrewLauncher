<!-- 仓库级统一构建配置：所有项目（主工程 + 测试工程）自动继承。
     目标：让 AI 生成的代码绕不过静态分析，从编译期掐死屎山。 -->
<Project>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>14</LangVersion>
        <!-- 默认 RID：仓库所有求值（真实构建 + IDE 设计时）统一到本机架构，
             免得各工程各配各的导致项目间引用解析到不存在的输出路径。
             仅当未显式指定时生效：CLI 的 -a、VS 传的 Platform（x64/ARM64…）都不受影响。
             背景：StarCrew.Launcher 主工程曾因此在 VSCode 里报 CS0103（XAML 生成缺席），
             测试工程也出现过 Core 引用解析失败，统一 RID 后这类问题不再有土壤。-->
        <_HostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_HostArch>
        <RuntimeIdentifier
            Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU') and '$(_HostArch)' == 'X64'"
            >win-x64</RuntimeIdentifier>
        <RuntimeIdentifier
            Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU') and '$(_HostArch)' == 'Arm64'"
            >win-arm64</RuntimeIdentifier>
        <RuntimeIdentifier
            Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU') and '$(_HostArch)' == 'X86'"
            >win-x86</RuntimeIdentifier>
        <!-- Roslyn 官方分析器全开（含 .NET SDK 内置 NetAnalyzers），效果对标 ESLint recommended 之上的 strict -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>All</AnalysisMode>
        <!-- 代码风格违规计入构建（需要 .editorconfig 配合 severity），对标 Ruff check -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- 警告即错误：CI 与本地 -p:TreatWarningsAsErrors=true 时生效，默认 true，硬门禁 -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- NuGet 漏洞审计，restore 时直接报错 -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
            >true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
